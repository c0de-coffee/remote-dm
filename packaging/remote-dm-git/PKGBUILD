# Maintainer: c0de-coffee <53132135+c0de-coffee@users.noreply.github.com>
#
# remote-dm: display manager for remote logins with gnome-remote-desktop (see README.md).
#
# Builds the main branch: of the repository this PKGBUILD lives in (committed changes only), or of
# https://github.com/c0de-coffee/remote-dm when built elsewhere (AUR).
# Override with REMOTE_DM_REPO=<url or path> and REMOTE_DM_BRANCH=<branch>.

pkgname=remote-dm-git
pkgver=r0.0
pkgrel=1
pkgdesc="Display manager for remote logins with gnome-remote-desktop"
arch=(x86_64)
url="https://github.com/c0de-coffee/remote-dm"
license=(GPL-3.0-only)
depends=(
  dbus
  gcc-libs
  glibc
  gnome-remote-desktop
  pam
  systemd
)
makedepends=(
  git
  rust
)
optdepends=(
  'niri: niri sessions (needs remote desktop support, see c0de-coffee/niri-remote)'
  'greetd-regreet: greeter (the default greeter.kdl, and KDE without plasma-login-manager)'
  'noctalia-greeter: greeter (greeter-noctalia.kdl)'
  'plasma-desktop: KDE Plasma sessions (also needs kwin-mutter-bridge)'
  'plasma-login-manager: KDE'"'"'s own login screen as the greeter on KDE'
)
provides=(remote-dm)
conflicts=(remote-dm)
backup=(
  etc/pam.d/remote-dm
  etc/pam.d/remote-dm-autologin
  etc/pam.d/remote-dm-greeter
  etc/remote-dm/config.toml
  etc/remote-dm/greeter.kdl
  etc/remote-dm/greeter-noctalia.kdl
)
# Inside a checkout of the repository (packaging/<pkg>/): the local repo; elsewhere (AUR): GitHub.
_repo=${REMOTE_DM_REPO:-$( [ -d "$startdir/../../.git" ] && realpath "$startdir/../.." || echo https://github.com/c0de-coffee/remote-dm)}
source=("remote-dm::git+file://${_repo#file://}#branch=${REMOTE_DM_BRANCH:-main}")
case $_repo in *://*) source=("remote-dm::git+$_repo#branch=${REMOTE_DM_BRANCH:-main}") ;; esac
sha256sums=('SKIP')

pkgver() {
  cd remote-dm
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd remote-dm
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd remote-dm
  cargo build --frozen --release
}

package() {
  cd remote-dm
  DESTDIR="$pkgdir" ./install.sh --no-build > /dev/null
  install -vDm 644 README.md README.zh-CN.md -t "$pkgdir/usr/share/doc/remote-dm/"
}
